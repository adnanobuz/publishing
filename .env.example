# ------------------------------------------------------------------
# PublishAll — environment configuration
# Copy this file to `.env` and fill in your own values.
# ------------------------------------------------------------------

# --- Database (required) ---
# Any PostgreSQL connection string. Free options: Neon, Supabase, Railway.
DATABASE_URL="postgresql://user:password@localhost:5432/publishall"

# --- Auth (required) ---
# Generate a secret with:  openssl rand -base64 32
# Set BOTH to the same value.
NEXTAUTH_SECRET="replace-with-a-long-random-string"
AUTH_SECRET="replace-with-a-long-random-string"

# The public URL of your deployment. Only needed in production.
# Example: https://publishall.yourdomain.com
# NEXTAUTH_URL="http://localhost:3000"

# --- AI content adaptation (required) ---
# Works with ANY OpenAI-compatible API. Pick one provider and fill these in.
#
# OpenAI example:
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY="sk-your-openai-key"
LLM_MODEL="gpt-4o-mini"
#
# See README.md for OpenRouter, Groq, and local Ollama examples.
